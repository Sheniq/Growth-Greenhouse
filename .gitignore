# Dependencies and build output
node_modules/
dist/
src-tauri/target/
src-tauri/gen/

# Keep only the Windows application icon and NSIS artwork. Tauri may generate
# unused Android, iOS, macOS, and extra PNG variants when refreshing icons.
src-tauri/icons/*
!src-tauri/icons/icon.ico
src-tauri/installer/*
!src-tauri/installer/header.bmp
!src-tauri/installer/sidebar.bmp
!src-tauri/installer/header.svg
!src-tauri/installer/sidebar.svg
.cargo/

# Local application data
*.db
*.db-shm
*.db-wal

# Logs and local environment files
*.log
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
